${jsonencode({
  "$schema" = "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
  version   = "Notebook/1.0"

  items = [
    {
      type = 1
      name = "title"

      content = {
        json = format(
          "# Task API Infrastructure — %s\n\nAKS node saturation · API server errors · pod restarts",
          environment
        )
      }
    },

    {
      type = 12
      name = "dashboard"

      content = {
        version   = "NotebookGroup/1.0"
        groupType = "editable"

        items = [
          {
            type        = 3
            name        = "api_errors"
            customWidth = "50"

            styleSettings = {
              showBorder = true
            }

            content = {
              version                 = "KqlItem/1.0"
              title                   = "API server errors · 24h"
              query                   = api_errors_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 0
              noDataMessage           = "No kube-apiserver Error/Fatal events in the last 24 hours."
            }
          },

          {
            type        = 3
            name        = "node_cpu"
            customWidth = "50"

            styleSettings = {
              showBorder = true
            }

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Node CPU · 10m average"
              query                   = node_cpu_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 0

              chartSettings = {
                ySettings = {
                  min = 0
                  max = 100
                }
              }

              noDataMessage = "No AKS node CPU metrics in the last 24 hours."
            }
          },

          {
            type        = 3
            name        = "node_memory"
            customWidth = "50"

            styleSettings = {
              showBorder = true
            }

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Node memory · 10m average"
              query                   = node_memory_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 0

              chartSettings = {
                ySettings = {
                  min = 0
                  max = 100
                }
              }

              noDataMessage = "No AKS node memory metrics in the last 24 hours."
            }
          },

          {
            type        = 3
            name        = "node_disk"
            customWidth = "50"

            styleSettings = {
              showBorder = true
            }

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Node disk · 10m average"
              query                   = node_disk_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 0

              chartSettings = {
                ySettings = {
                  min = 0
                  max = 100
                }
              }

              noDataMessage = "No AKS node disk metrics in the last 24 hours."
            }
          },

          {
            type        = 3
            name        = "pod_restarts"
            customWidth = "50"

            styleSettings = {
              showBorder = true
            }

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Pod restarts · 15m"
              query                   = pod_restarts_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "table"
              size                    = 0
              noDataMessage           = "No pod restart growth detected in the last 15 minutes."
            }
          }
        ]
      }
    }
  ]

  isLocked            = true
  defaultResourceIds  = [workspace_id]
  fallbackResourceIds = [workspace_id]
})}
