${jsonencode({
  "$schema" = "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
  version   = "Notebook/1.0"

  items = [
    {
      type = 1
      name = "title"

      content = {
        json = format(
          "# Task API Database\n\n## Environment: %s\n\nPostgreSQL Flexible Server health, performance, and log diagnostics.",
          environment
        )
      }
    },
    {
      type = 1
      name = "context"

      content = {
        json = format(
          "### Monitoring context\n\n**Log Analytics workspace**  \n`%s`\n\nMetrics come from Azure Monitor platform metrics. PostgreSQL server diagnostics and Query Store data require the corresponding diagnostic categories to be enabled.",
          workspace_id
        )
      }
    },
    {
      type = 3
      name = "connections"

      content = {
        version                 = "KqlItem/1.0"
        title                   = "Active connections"
        query                   = connections_query
        queryType               = 0
        resourceType            = "microsoft.operationalinsights/workspaces"
        crossComponentResources = [workspace_id]
        visualization           = "timechart"
        size                    = 0
      }
    },
    {
      type = 3
      name = "cpu"

      content = {
        version                 = "KqlItem/1.0"
        title                   = "CPU percent"
        query                   = cpu_query
        queryType               = 0
        resourceType            = "microsoft.operationalinsights/workspaces"
        crossComponentResources = [workspace_id]
        visualization           = "timechart"
        size                    = 0
      }
    },
    {
      type = 3
      name = "storage"

      content = {
        version                 = "KqlItem/1.0"
        title                   = "Storage percent"
        query                   = storage_query
        queryType               = 0
        resourceType            = "microsoft.operationalinsights/workspaces"
        crossComponentResources = [workspace_id]
        visualization           = "timechart"
        size                    = 0
      }
    },
    {
      type = 3
      name = "slow_queries"

      content = {
        version                 = "KqlItem/1.0"
        title                   = "Top query-performance outliers"
        query                   = slow_queries_query
        queryType               = 0
        resourceType            = "microsoft.operationalinsights/workspaces"
        crossComponentResources = [workspace_id]
        visualization           = "table"
        size                    = 0
      }
    },
    {
      type = 3
      name = "errors_table"

      content = {
        version                 = "KqlItem/1.0"
        title                   = "Recent PostgreSQL error logs"
        query                   = errors_query
        queryType               = 0
        resourceType            = "microsoft.operationalinsights/workspaces"
        crossComponentResources = [workspace_id]
        visualization           = "table"
        size                    = 0
      }
    }
  ]

  isLocked           = false
  defaultResourceIds = [workspace_id]
})}
