${jsonencode({
  "$schema" = "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
  version   = "Notebook/1.0"

  items = [
    {
      type = 1
      name = "title"

      content = {
        json = format(
          "# Task API Canary Release — %s\n\nStable vs canary · error rate · latency · exceptions",
          environment
        )
      }
    },

    {
      type = 12
      name = "dashboard"

      content = {
        version   = "NotebookGroup/1.0"
        groupType = "editable"

        items = [
          {
            type        = 3
            name        = "traffic_split"
            customWidth = "50"

            styleSettings = {
              showBorder = true
            }

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Traffic split · 5m"
              query                   = traffic_split_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "areachart"
              size                    = 0
              noDataMessage           = "No request telemetry in the last hour."
            }
          },

          {
            type        = 3
            name        = "error_rate"
            customWidth = "50"

            styleSettings = {
              showBorder = true
            }

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Error rate by version · 5m"
              query                   = error_rate_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 0

              chartSettings = {
                ySettings = {
                  min = 0
                  max = 100
                }
              }

              noDataMessage = "No request telemetry in the last hour."
            }
          },

          {
            type        = 3
            name        = "latency"
            customWidth = "50"

            styleSettings = {
              showBorder = true
            }

            content = {
              version                 = "KqlItem/1.0"
              title                   = "P95 latency by version · 5m"
              query                   = latency_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "timechart"
              size                    = 0
              noDataMessage           = "No versioned request latency telemetry in the last hour."
            }
          },

          {
            type        = 3
            name        = "exceptions"
            customWidth = "50"

            styleSettings = {
              showBorder = true
            }

            content = {
              version                 = "KqlItem/1.0"
              title                   = "Recent exceptions · 1h"
              query                   = exceptions_query
              queryType               = 0
              resourceType            = "microsoft.operationalinsights/workspaces"
              crossComponentResources = [workspace_id]
              visualization           = "table"
              size                    = 0
              noDataMessage           = "No Application Insights exceptions in the last hour."
            }
          }
        ]
      }
    }
  ]

  isLocked            = true
  defaultResourceIds  = [workspace_id]
  fallbackResourceIds = [workspace_id]
})}
