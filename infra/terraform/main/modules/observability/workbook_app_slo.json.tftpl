${jsonencode({
  "$schema" = "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
  version   = "Notebook/1.0"

  items = [
    {
      type = 1
      name = "title"

      content = {
        json = format(
          "# Task API Application SLO\n\n## Environment: %s\n\nGolden signals: latency, traffic, errors, and business metrics.",
          environment
        )
      }
    },
    {
      type = 1
      name = "context"

      content = {
        json = format(
          "### Monitoring context\n\n**Log Analytics workspace**  \n`%s`\n\n**Application Insights component**  \n`%s`\n\nKQL items execute against the workspace and filter application telemetry to this component.",
          workspace_id,
          application_insights_id
        )
      }
    },
    {
      type = 3
      name = "slo_snapshot"

      content = {
        version                 = "KqlItem/1.0"
        title                   = "SLO snapshot (24h)"
        query                   = snapshot_query
        queryType               = 0
        resourceType            = "microsoft.operationalinsights/workspaces"
        crossComponentResources = [workspace_id]
        visualization           = "table"
        size                    = 0
      }
    },
    {
      type = 3
      name = "latency"

      content = {
        version                 = "KqlItem/1.0"
        title                   = "Latency P95/P50"
        query                   = latency_query
        queryType               = 0
        resourceType            = "microsoft.operationalinsights/workspaces"
        crossComponentResources = [workspace_id]
        visualization           = "timechart"
        size                    = 0
      }
    },
    {
      type = 3
      name = "traffic"

      content = {
        version                 = "KqlItem/1.0"
        title                   = "Request volume"
        query                   = traffic_query
        queryType               = 0
        resourceType            = "microsoft.operationalinsights/workspaces"
        crossComponentResources = [workspace_id]
        visualization           = "timechart"
        size                    = 0
      }
    },
    {
      type = 3
      name = "errors"

      content = {
        version                 = "KqlItem/1.0"
        title                   = "Error rate"
        query                   = errors_query
        queryType               = 0
        resourceType            = "microsoft.operationalinsights/workspaces"
        crossComponentResources = [workspace_id]
        visualization           = "timechart"
        size                    = 0
      }
    },
    {
      type = 3
      name = "custom_metrics"

      content = {
        version                 = "KqlItem/1.0"
        title                   = "Business metrics"
        query                   = custom_metrics_query
        queryType               = 0
        resourceType            = "microsoft.operationalinsights/workspaces"
        crossComponentResources = [workspace_id]
        visualization           = "timechart"
        size                    = 0
      }
    }
  ]

  isLocked           = false
  defaultResourceIds = [workspace_id]
})}